diff --git a/backend/fbdev/backend.c b/backend/fbdev/backend.c
new file mode 100644
index 0000000..1262caf
--- /dev/null
+++ b/backend/fbdev/backend.c
@@ -0,0 +1,556 @@
+#include <assert.h>
+#include <drm_fourcc.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <linux/fb.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <time.h>
+#include <unistd.h>
+#include <wlr/backend/fbdev.h>
+#include <wlr/backend/interface.h>
+#include <wlr/backend/session.h>
+#include <wlr/interfaces/wlr_buffer.h>
+#include <wlr/interfaces/wlr_output.h>
+#include <wlr/render/drm_format_set.h>
+#include <wlr/util/log.h>
+#include "types/wlr_output.h"
+
+#define FBDEV_DEFAULT_REFRESH (60 * 1000) // 60 Hz
+
+static const uint32_t SUPPORTED_OUTPUT_STATE =
+	WLR_OUTPUT_STATE_BACKEND_OPTIONAL |
+	WLR_OUTPUT_STATE_BUFFER |
+	WLR_OUTPUT_STATE_ENABLED |
+	WLR_OUTPUT_STATE_MODE;
+
+struct wlr_fbdev_output;
+
+struct wlr_fbdev_backend {
+	struct wlr_backend backend;
+	struct wl_event_loop *event_loop;
+	struct wlr_session *session; // may be NULL
+	struct wlr_fbdev_output *output; // NULL once destroyed
+	bool started;
+
+	struct wl_listener event_loop_destroy;
+	struct wl_listener session_active;
+	struct wl_listener session_destroy;
+};
+
+struct wlr_fbdev_output {
+	struct wlr_output wlr_output;
+	struct wlr_fbdev_backend *backend;
+
+	int fd;
+	uint8_t *map; // whole framebuffer memory
+	size_t map_size;
+	uint8_t *visible; // start of the visible area in map
+	size_t line_length; // bytes
+	int width, height;
+	uint32_t format; // DRM format of the framebuffer
+	struct wlr_drm_format_set primary_formats;
+
+	struct wl_event_source *frame_timer;
+	int frame_delay; // ms
+	int64_t last_frame_ns; // CLOCK_MONOTONIC of the last frame event
+	// next frame must copy the whole buffer (first frame, after VT switch...)
+	bool full_damage;
+	// clean written cache lines (WLR_FBDEV_CLEAN_CACHE=0 disables)
+	bool clean_cache;
+};
+
+static const struct wlr_backend_impl backend_impl;
+static const struct wlr_output_impl output_impl;
+
+static struct wlr_fbdev_backend *fbdev_backend_from_backend(
+		struct wlr_backend *wlr_backend) {
+	assert(wlr_backend_is_fbdev(wlr_backend));
+	struct wlr_fbdev_backend *backend = wl_container_of(wlr_backend, backend, backend);
+	return backend;
+}
+
+static struct wlr_fbdev_output *fbdev_output_from_output(
+		struct wlr_output *wlr_output) {
+	assert(wlr_output_is_fbdev(wlr_output));
+	struct wlr_fbdev_output *output = wl_container_of(wlr_output, output, wlr_output);
+	return output;
+}
+
+static int64_t now_ns(void) {
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (int64_t)ts.tv_sec * 1000000000 + ts.tv_nsec;
+}
+
+static bool output_active(struct wlr_fbdev_output *output) {
+	struct wlr_session *session = output->backend->session;
+	return session == NULL || session->active;
+}
+
+static bool output_test(struct wlr_output *wlr_output,
+		const struct wlr_output_state *state) {
+	struct wlr_fbdev_output *output = fbdev_output_from_output(wlr_output);
+
+	uint32_t unsupported = state->committed & ~SUPPORTED_OUTPUT_STATE;
+	if (unsupported != 0) {
+		wlr_log(WLR_DEBUG, "Unsupported output state fields: 0x%"PRIx32,
+			unsupported);
+		return false;
+	}
+
+	if (state->committed & WLR_OUTPUT_STATE_MODE) {
+		int width, height;
+		if (state->mode_type == WLR_OUTPUT_STATE_MODE_FIXED) {
+			width = state->mode->width;
+			height = state->mode->height;
+		} else {
+			width = state->custom_mode.width;
+			height = state->custom_mode.height;
+		}
+		if (width != output->width || height != output->height) {
+			wlr_log(WLR_DEBUG, "fbdev mode is fixed at %dx%d",
+				output->width, output->height);
+			return false;
+		}
+	}
+
+	if (state->committed & WLR_OUTPUT_STATE_BUFFER) {
+		struct wlr_buffer *buffer = state->buffer;
+		// The framebuffer is filled with the CPU (e.g. no direct scan-out
+		// of GPU client buffers)
+		if (buffer->impl->begin_data_ptr_access == NULL) {
+			wlr_log(WLR_DEBUG, "Buffer can't be read by the CPU");
+			return false;
+		}
+		if (buffer->width != output->width || buffer->height != output->height) {
+			wlr_log(WLR_DEBUG, "Buffer size %dx%d doesn't match fbdev size %dx%d",
+				buffer->width, buffer->height, output->width, output->height);
+			return false;
+		}
+	}
+
+	return true;
+}
+
+/*
+ * Some fbdev drivers (e.g. the Exynos decon) map the framebuffer CPU-cached
+ * while the display engine reads memory directly: written lines must be
+ * cleaned to the point of coherency, or stale cache lines show up on screen.
+ * Linux lets user space do this on arm64 (SCTLR_EL1.UCI).
+ */
+#if defined(__aarch64__)
+static void clean_dcache_range(const uint8_t *start, size_t len) {
+	static size_t line = 0;
+	if (line == 0) {
+		uint64_t ctr;
+		__asm__ volatile("mrs %0, ctr_el0" : "=r"(ctr));
+		line = (size_t)4 << ((ctr >> 16) & 0xf);
+	}
+	uintptr_t p = (uintptr_t)start & ~(uintptr_t)(line - 1);
+	uintptr_t end = (uintptr_t)start + len;
+	for (; p < end; p += line) {
+		__asm__ volatile("dc cvac, %0" : : "r"(p) : "memory");
+	}
+}
+
+static void dcache_barrier(void) {
+	__asm__ volatile("dsb sy" : : : "memory");
+}
+#else
+static void clean_dcache_range(const uint8_t *start, size_t len) {}
+static void dcache_barrier(void) {}
+#endif
+
+static void copy_rect(struct wlr_fbdev_output *output, const uint8_t *src,
+		size_t src_stride, uint32_t src_format, const pixman_box32_t *box,
+		bool clean_cache) {
+	size_t x_off = (size_t)box->x1 * 4;
+	size_t len = (size_t)(box->x2 - box->x1) * 4;
+	// XRGB8888 <-> XBGR8888 differ in the red/blue byte order only
+	bool swap_rb = (src_format == DRM_FORMAT_ABGR8888 ||
+		src_format == DRM_FORMAT_XBGR8888) !=
+		(output->format == DRM_FORMAT_XBGR8888);
+
+	for (int y = box->y1; y < box->y2; y++) {
+		const uint8_t *s = src + (size_t)y * src_stride + x_off;
+		uint8_t *d = output->visible + (size_t)y * output->line_length + x_off;
+		if (!swap_rb) {
+			memcpy(d, s, len);
+		} else {
+			const uint32_t *s32 = (const uint32_t *)s;
+			uint32_t *d32 = (uint32_t *)d;
+			for (size_t x = 0; x < len / 4; x++) {
+				uint32_t p = s32[x];
+				d32[x] = (p & 0xFF00FF00) | ((p >> 16) & 0xFF) | ((p & 0xFF) << 16);
+			}
+		}
+		if (clean_cache) {
+			clean_dcache_range(d, len);
+		}
+	}
+}
+
+static bool output_present_buffer(struct wlr_fbdev_output *output,
+		const struct wlr_output_state *state) {
+	struct wlr_buffer *buffer = state->buffer;
+
+	void *data;
+	uint32_t format;
+	size_t stride;
+	if (!wlr_buffer_begin_data_ptr_access(buffer, WLR_BUFFER_DATA_PTR_ACCESS_READ,
+			&data, &format, &stride)) {
+		wlr_log(WLR_ERROR, "Failed to access buffer data");
+		return false;
+	}
+	if (format != DRM_FORMAT_XRGB8888 && format != DRM_FORMAT_ARGB8888 &&
+			format != DRM_FORMAT_XBGR8888 && format != DRM_FORMAT_ABGR8888) {
+		wlr_buffer_end_data_ptr_access(buffer);
+		wlr_log(WLR_ERROR, "Unsupported buffer format 0x%"PRIX32, format);
+		return false;
+	}
+
+	pixman_region32_t damage;
+	pixman_region32_init_rect(&damage, 0, 0, output->width, output->height);
+	if (!output->full_damage && (state->committed & WLR_OUTPUT_STATE_DAMAGE)) {
+		pixman_region32_intersect(&damage, &damage, &state->damage);
+	}
+	output->full_damage = false;
+
+	int rects_len = 0;
+	const pixman_box32_t *rects = pixman_region32_rectangles(&damage, &rects_len);
+	for (int i = 0; i < rects_len; i++) {
+		copy_rect(output, data, stride, format, &rects[i], output->clean_cache);
+	}
+	if (output->clean_cache) {
+		dcache_barrier();
+	}
+	pixman_region32_fini(&damage);
+
+	wlr_buffer_end_data_ptr_access(buffer);
+	return true;
+}
+
+static void output_set_blank(struct wlr_fbdev_output *output, bool blank) {
+	if (ioctl(output->fd, FBIOBLANK, blank ? FB_BLANK_POWERDOWN : FB_BLANK_UNBLANK) != 0) {
+		wlr_log_errno(WLR_DEBUG, "FBIOBLANK failed");
+	}
+}
+
+static bool output_commit(struct wlr_output *wlr_output,
+		const struct wlr_output_state *state) {
+	struct wlr_fbdev_output *output = fbdev_output_from_output(wlr_output);
+
+	if (!output_test(wlr_output, state)) {
+		return false;
+	}
+
+	if (state->committed & WLR_OUTPUT_STATE_ENABLED) {
+		output_set_blank(output, !state->enabled);
+		output->full_damage = true;
+	const char *clean = getenv("WLR_FBDEV_CLEAN_CACHE");
+	output->clean_cache = clean == NULL || strcmp(clean, "0") != 0;
+	}
+
+	if ((state->committed & WLR_OUTPUT_STATE_BUFFER) && output_active(output)) {
+		if (!output_present_buffer(output, state)) {
+			return false;
+		}
+	}
+
+	if (output_pending_enabled(wlr_output, state)) {
+		struct wlr_output_event_present present_event = {
+			.commit_seq = wlr_output->commit_seq + 1,
+			.presented = true,
+		};
+		output_defer_present(wlr_output, present_event);
+
+		// Frames on a fixed clock: the next one is due one refresh period
+		// after the previous frame event, not after this (slow) commit
+		int64_t now = now_ns();
+		int64_t due = output->last_frame_ns + (int64_t)output->frame_delay * 1000000;
+		int delay_ms = due > now ? (int)((due - now + 999999) / 1000000) : 1;
+		wl_event_source_timer_update(output->frame_timer, delay_ms);
+	}
+
+	return true;
+}
+
+static const struct wlr_drm_format_set *output_get_primary_formats(
+		struct wlr_output *wlr_output, uint32_t buffer_caps) {
+	struct wlr_fbdev_output *output = fbdev_output_from_output(wlr_output);
+	return &output->primary_formats;
+}
+
+static void output_destroy(struct wlr_output *wlr_output) {
+	struct wlr_fbdev_output *output = fbdev_output_from_output(wlr_output);
+
+	wlr_output_finish(wlr_output);
+
+	output->backend->output = NULL;
+	wl_event_source_remove(output->frame_timer);
+	wlr_drm_format_set_finish(&output->primary_formats);
+	munmap(output->map, output->map_size);
+	close(output->fd);
+	free(output);
+}
+
+static const struct wlr_output_impl output_impl = {
+	.destroy = output_destroy,
+	.test = output_test,
+	.commit = output_commit,
+	.get_primary_formats = output_get_primary_formats,
+	// no hardware cursor: wlroots draws a software cursor
+};
+
+bool wlr_output_is_fbdev(struct wlr_output *wlr_output) {
+	return wlr_output->impl == &output_impl;
+}
+
+static int signal_frame(void *data) {
+	struct wlr_fbdev_output *output = data;
+	output->last_frame_ns = now_ns();
+	wlr_output_send_frame(&output->wlr_output);
+	return 0;
+}
+
+static uint32_t format_from_var(const struct fb_var_screeninfo *var) {
+	if (var->bits_per_pixel != 32 || var->red.length != 8 ||
+			var->green.length != 8 || var->blue.length != 8 ||
+			var->green.offset != 8) {
+		return DRM_FORMAT_INVALID;
+	}
+	if (var->red.offset == 16 && var->blue.offset == 0) {
+		return DRM_FORMAT_XRGB8888;
+	}
+	if (var->red.offset == 0 && var->blue.offset == 16) {
+		return DRM_FORMAT_XBGR8888;
+	}
+	return DRM_FORMAT_INVALID;
+}
+
+static int32_t refresh_from_var(const struct fb_var_screeninfo *var) {
+	if (var->pixclock == 0) {
+		return FBDEV_DEFAULT_REFRESH;
+	}
+	uint64_t htotal = (uint64_t)var->xres + var->left_margin +
+		var->right_margin + var->hsync_len;
+	uint64_t vtotal = (uint64_t)var->yres + var->upper_margin +
+		var->lower_margin + var->vsync_len;
+	// pixclock is in picoseconds
+	uint64_t mhz = 1000000000000000ULL / var->pixclock / (htotal * vtotal);
+	if (mhz < 10000 || mhz > 250000) {
+		return FBDEV_DEFAULT_REFRESH;
+	}
+	return (int32_t)mhz;
+}
+
+static struct wlr_fbdev_output *output_create(struct wlr_fbdev_backend *backend,
+		const char *path) {
+	int fd = open(path, O_RDWR | O_CLOEXEC);
+	if (fd < 0) {
+		wlr_log_errno(WLR_ERROR, "Failed to open %s", path);
+		return NULL;
+	}
+
+	struct fb_var_screeninfo var;
+	struct fb_fix_screeninfo fix;
+	if (ioctl(fd, FBIOGET_VSCREENINFO, &var) != 0 ||
+			ioctl(fd, FBIOGET_FSCREENINFO, &fix) != 0) {
+		wlr_log_errno(WLR_ERROR, "Failed to query %s", path);
+		goto error_fd;
+	}
+
+	uint32_t format = format_from_var(&var);
+	if (format == DRM_FORMAT_INVALID) {
+		wlr_log(WLR_ERROR, "Unsupported framebuffer format: %"PRIu32" bpp, "
+			"red %"PRIu32"/%"PRIu32" green %"PRIu32"/%"PRIu32" blue %"PRIu32"/%"PRIu32,
+			var.bits_per_pixel, var.red.offset, var.red.length,
+			var.green.offset, var.green.length, var.blue.offset, var.blue.length);
+		goto error_fd;
+	}
+
+	size_t visible_offset = (size_t)var.yoffset * fix.line_length + (size_t)var.xoffset * 4;
+	if (visible_offset + (size_t)var.yres * fix.line_length > fix.smem_len) {
+		wlr_log(WLR_ERROR, "Framebuffer memory too small");
+		goto error_fd;
+	}
+
+	uint8_t *map = mmap(NULL, fix.smem_len, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+	if (map == MAP_FAILED) {
+		wlr_log_errno(WLR_ERROR, "Failed to mmap %s", path);
+		goto error_fd;
+	}
+
+	struct wlr_fbdev_output *output = calloc(1, sizeof(*output));
+	if (output == NULL) {
+		wlr_log_errno(WLR_ERROR, "Allocation failed");
+		munmap(map, fix.smem_len);
+		goto error_fd;
+	}
+	output->backend = backend;
+	output->fd = fd;
+	output->map = map;
+	output->map_size = fix.smem_len;
+	output->visible = map + visible_offset;
+	output->line_length = fix.line_length;
+	output->width = var.xres;
+	output->height = var.yres;
+	output->format = format;
+	output->full_damage = true;
+
+	// Let the renderer pick either byte order, but prefer the native one
+	wlr_drm_format_set_add(&output->primary_formats, format, DRM_FORMAT_MOD_LINEAR);
+	wlr_drm_format_set_add(&output->primary_formats, format, DRM_FORMAT_MOD_INVALID);
+	uint32_t alpha_format = format == DRM_FORMAT_XRGB8888 ?
+		DRM_FORMAT_ARGB8888 : DRM_FORMAT_ABGR8888;
+	wlr_drm_format_set_add(&output->primary_formats, alpha_format, DRM_FORMAT_MOD_LINEAR);
+	wlr_drm_format_set_add(&output->primary_formats, alpha_format, DRM_FORMAT_MOD_INVALID);
+
+	int32_t refresh = refresh_from_var(&var);
+	output->frame_delay = 1000000 / refresh;
+
+	struct wlr_output *wlr_output = &output->wlr_output;
+	struct wlr_output_state state;
+	wlr_output_state_init(&state);
+	wlr_output_state_set_custom_mode(&state, output->width, output->height, refresh);
+	wlr_output_init(wlr_output, &backend->backend, &output_impl,
+		backend->event_loop, &state);
+	wlr_output_state_finish(&state);
+
+	// Unknown sizes are reported as 0 or -1 (UINT32_MAX)
+	if (var.width > 0 && var.width < 10000 && var.height > 0 && var.height < 10000) {
+		wlr_output->phys_width = var.width;
+		wlr_output->phys_height = var.height;
+	}
+
+	const char *name = strrchr(path, '/');
+	name = name ? name + 1 : path;
+	char output_name[64];
+	snprintf(output_name, sizeof(output_name), "FBDEV-%s", name);
+	wlr_output_set_name(wlr_output, output_name);
+
+	char description[128];
+	snprintf(description, sizeof(description), "Framebuffer %s (%.16s)", path, fix.id);
+	wlr_output_set_description(wlr_output, description);
+
+	output->frame_timer = wl_event_loop_add_timer(backend->event_loop,
+		signal_frame, output);
+
+	wlr_log(WLR_INFO, "fbdev output %s: %dx%d @ %.3f Hz, %s, stride %zu",
+		path, output->width, output->height, refresh / 1000.0,
+		format == DRM_FORMAT_XRGB8888 ? "XRGB8888" : "XBGR8888",
+		output->line_length);
+	return output;
+
+error_fd:
+	close(fd);
+	return NULL;
+}
+
+static bool backend_start(struct wlr_backend *wlr_backend) {
+	struct wlr_fbdev_backend *backend = fbdev_backend_from_backend(wlr_backend);
+	wlr_log(WLR_INFO, "Starting fbdev backend");
+
+	if (backend->output != NULL) {
+		wl_signal_emit_mutable(&backend->backend.events.new_output,
+			&backend->output->wlr_output);
+	}
+
+	backend->started = true;
+	return true;
+}
+
+static void backend_destroy(struct wlr_backend *wlr_backend) {
+	if (!wlr_backend) {
+		return;
+	}
+	struct wlr_fbdev_backend *backend = fbdev_backend_from_backend(wlr_backend);
+
+	wlr_backend_finish(wlr_backend);
+
+	if (backend->output != NULL) {
+		wlr_output_destroy(&backend->output->wlr_output);
+	}
+
+	wl_list_remove(&backend->event_loop_destroy.link);
+	if (backend->session != NULL) {
+		wl_list_remove(&backend->session_active.link);
+		wl_list_remove(&backend->session_destroy.link);
+	}
+	free(backend);
+}
+
+static const struct wlr_backend_impl backend_impl = {
+	.start = backend_start,
+	.destroy = backend_destroy,
+};
+
+bool wlr_backend_is_fbdev(struct wlr_backend *backend) {
+	return backend->impl == &backend_impl;
+}
+
+static void handle_event_loop_destroy(struct wl_listener *listener, void *data) {
+	struct wlr_fbdev_backend *backend =
+		wl_container_of(listener, backend, event_loop_destroy);
+	backend_destroy(&backend->backend);
+}
+
+static void handle_session_active(struct wl_listener *listener, void *data) {
+	struct wlr_fbdev_backend *backend =
+		wl_container_of(listener, backend, session_active);
+	if (backend->output == NULL || !backend->session->active) {
+		return;
+	}
+	// Whatever was on the VT we come back from is in the framebuffer now
+	backend->output->full_damage = true;
+	wlr_output_update_needs_frame(&backend->output->wlr_output);
+}
+
+static void handle_session_destroy(struct wl_listener *listener, void *data) {
+	struct wlr_fbdev_backend *backend =
+		wl_container_of(listener, backend, session_destroy);
+	wl_list_remove(&backend->session_active.link);
+	wl_list_remove(&backend->session_destroy.link);
+	backend->session = NULL;
+}
+
+struct wlr_backend *wlr_fbdev_backend_create(struct wl_event_loop *loop,
+		struct wlr_session *session, const char *path) {
+	wlr_log(WLR_INFO, "Creating fbdev backend for %s", path);
+
+	struct wlr_fbdev_backend *backend = calloc(1, sizeof(*backend));
+	if (!backend) {
+		wlr_log(WLR_ERROR, "Failed to allocate wlr_fbdev_backend");
+		return NULL;
+	}
+
+	wlr_backend_init(&backend->backend, &backend_impl);
+	// The output reads rendered buffers with the CPU
+	backend->backend.buffer_caps = WLR_BUFFER_CAP_DATA_PTR | WLR_BUFFER_CAP_SHM;
+	backend->event_loop = loop;
+	backend->session = session;
+
+	backend->output = output_create(backend, path);
+	if (backend->output == NULL) {
+		wlr_backend_finish(&backend->backend);
+		free(backend);
+		return NULL;
+	}
+
+	backend->event_loop_destroy.notify = handle_event_loop_destroy;
+	wl_event_loop_add_destroy_listener(loop, &backend->event_loop_destroy);
+
+	if (session != NULL) {
+		backend->session_active.notify = handle_session_active;
+		wl_signal_add(&session->events.active, &backend->session_active);
+		backend->session_destroy.notify = handle_session_destroy;
+		wl_signal_add(&session->events.destroy, &backend->session_destroy);
+	}
+
+	return &backend->backend;
+}
