# sway on ARMtix, Galaxy S8+ (1440x2960, 70x143 mm). Touch first: waybar has
# buttons for apps, the on-screen keyboard, rotation, closing the focused
# window and the power menu. Super = Mod4 on a USB keyboard.
# The look is a theme: `armtix-theme` lists them, `armtix-theme minimal`
# switches (themes in ~/.config/armtix-themes).
#
# Rendering: Mali GPU via libhybris; display: fbdev backend (see armtix-sway).

set $mod Mod4
set $term foot
set $menu fuzzel
set $out FBDEV-fb0

### Output
# scale 3 -> 480x987 logical pixels in portrait
output $out scale 3

### Input
# The touchscreen follows rotation (armtix-rotate)
input type:touch map_to_output $out
input type:tablet_tool map_to_output $out
input type:keyboard {
	xkb_layout us
	repeat_delay 400
	repeat_rate 30
}
input type:pointer accel_profile flat
# touch first: the pointer (lan-mouse, USB mouse) hides when it's idle
seat * hide_cursor 3000

### Look: colors, fonts, borders and wallpaper come from the theme
# (armtix-theme, themes in ~/.config/armtix-themes)
include ~/.config/sway/theme
# wallpaper for the current rotation (or just the background color)
exec_always armtix-rotate wallpaper
# One window per screen like a phone, the others as tabs
workspace_layout tabbed
focus_on_window_activation focus

### Phone buttons
bindsym --locked XF86PowerOff exec armtix-power-menu
bindsym --locked XF86AudioRaiseVolume exec armtix-volume up
bindsym --locked XF86AudioLowerVolume exec armtix-volume down
bindsym --locked XF86AudioMute exec armtix-volume mute

### Keyboard shortcuts
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec armtix-power-menu
bindsym $mod+o exec armtix-osk toggle
bindsym $mod+r exec armtix-rotate next
bindsym $mod+f fullscreen toggle
bindsym $mod+space floating toggle
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
floating_modifier $mod normal

# Dialogs (power menu, Wi-Fi picker) float
for_window [app_id="yad"] floating enable
for_window [class="Yad"] floating enable

### Bar
bar {
	swaybar_command waybar
}

### Session
exec pulseaudio --start
# speaker at 30% on the very first login (as under XFCE)
exec sh -c 'f=$HOME/.config/armtix-volume-set; [ -e "$f" ] && exit 0; sleep 4; pactl set-sink-volume speaker 30% && touch "$f"'
exec mako
exec armtix-osk start
# screen on/off as set in /etc/armtix/screen.conf (sway would switch it on)
exec armtix-screen apply
# keyboard/mouse from a PC (lan-mouse, if installed and configured). A
# receiver left over from a previous session holds the port but feeds a dead
# Wayland display: replace it.
exec sh -c 'command -v lan-mouse >/dev/null && [ -f ~/.config/lan-mouse/config.toml ] && { pkill -u "$USER" -x lan-mouse; exec lan-mouse daemon > ~/.local/state/lan-mouse.log 2>&1; }'
