+struct wlr_egl *wlr_egl_create_hybris(void) {
+	struct wlr_egl *egl = egl_create();
+	if (egl == NULL) {
+		return NULL;
+	}
+
+	// The Android platform is only provided by libhybris (its "null" window
+	// system: the compositor only renders into gralloc buffers)
+	EGLDisplay display = egl->procs.eglGetPlatformDisplayEXT(
+		EGL_PLATFORM_ANDROID_KHR, EGL_DEFAULT_DISPLAY, NULL);
+	if (display == EGL_NO_DISPLAY) {
+		wlr_log(WLR_DEBUG, "No libhybris EGL (EGL_PLATFORM_ANDROID_KHR unsupported)");
+		goto error;
+	}
+	// GLVND advertises EGL_EXT_device_query itself, but Android EGL has no
+	// EGLDevice
+	egl->exts.EXT_device_query = false;
+	if (!egl_init_display(egl, display, true) || !egl_init_context(egl)) {
+		goto error;
+	}
+	if (!egl->exts.KHR_image_base) {
+		wlr_log(WLR_ERROR, "EGL_KHR_image_base not supported");
+		goto error;
+	}
+
+	// With GLVND these dispatch to the vendor of the current context, so
+	// callers must make the context current
+	struct {
+		void *proc_ptr;
+		const char *name;
+	} procs[] = {
+		{ &egl->hybris.create_native_buffer, "eglHybrisCreateNativeBuffer" },
+		{ &egl->hybris.lock_native_buffer, "eglHybrisLockNativeBuffer" },
+		{ &egl->hybris.unlock_native_buffer, "eglHybrisUnlockNativeBuffer" },
+		{ &egl->hybris.release_native_buffer, "eglHybrisReleaseNativeBuffer" },
+		{ &egl->hybris.bind_wayland_display, "eglBindWaylandDisplayWL" },
+		{ &egl->hybris.unbind_wayland_display, "eglUnbindWaylandDisplayWL" },
+		{ &egl->hybris.query_wayland_buffer, "eglQueryWaylandBufferWL" },
+	};
+	for (size_t i = 0; i < sizeof(procs) / sizeof(procs[0]); i++) {
+		void *proc = (void *)eglGetProcAddress(procs[i].name);
+		if (proc == NULL) {
+			wlr_log(WLR_ERROR, "eglGetProcAddress(%s) failed", procs[i].name);
+			goto error_context;
+		}
+		*(void **)procs[i].proc_ptr = proc;
+	}
+	egl->is_hybris = true;
+
+	wlr_log(WLR_INFO, "Using libhybris EGL");
+	return egl;
+
+error_context:
+	eglDestroyContext(egl->display, egl->context);
+error:
+	wlr_log(WLR_DEBUG, "Failed to initialize libhybris EGL");
+	free(egl);
+	eglReleaseThread();
+	return NULL;
+}
+
+EGLImageKHR wlr_egl_create_image_from_hybris(struct wlr_egl *egl,
+		EGLenum target, EGLClientBuffer buffer) {
+	static const EGLint attribs[] = {
+		// Our clients don't expect our usage to trash the buffer contents
+		EGL_IMAGE_PRESERVED_KHR, EGL_TRUE,
+		EGL_NONE,
+	};
+	EGLImageKHR image = egl->procs.eglCreateImageKHR(egl->display,
+		EGL_NO_CONTEXT, target, buffer, attribs);
+	if (image == EGL_NO_IMAGE_KHR) {
+		wlr_log(WLR_ERROR, "eglCreateImageKHR failed for libhybris buffer");
+	}
+	return image;
+}
