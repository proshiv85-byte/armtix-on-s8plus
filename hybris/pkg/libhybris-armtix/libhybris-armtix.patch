+/*
+ * Android drivers tear down the EGL surfaces still alive at exit from their
+ * own exit handlers, when the application's Wayland objects may be gone. Skip
+ * the Wayland and gralloc cleanup then: the process is going away anyway.
+ *
+ * glibc runs thread_local destructors before atexit handlers, newest first,
+ * so a guard armed once the driver has set up its own handlers (i.e. on the
+ * first dequeueBuffer) fires before the driver's teardown.
+ */
+static bool wayland_process_exiting = false;
+
+namespace {
+struct ExitGuard {
+    ~ExitGuard() { wayland_process_exiting = true; }
+};
+}
+
+void hybris_wayland_arm_exit_guard()
+{
+    static thread_local ExitGuard guard;
+    (void) &guard;
+}
