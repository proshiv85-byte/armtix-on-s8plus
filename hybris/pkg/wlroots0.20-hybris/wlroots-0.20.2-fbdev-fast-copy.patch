+// Thread `index` of `count` copies its contiguous share of every rectangle
+static void copy_job_part(const struct fbdev_copy_job *job, int index, int count) {
+	for (int i = 0; i < job->rects_len; i++) {
+		const pixman_box32_t *box = &job->rects[i];
+		int rows = box->y2 - box->y1;
+		int y1 = box->y1 + (int)((int64_t)rows * index / count);
+		int y2 = box->y1 + (int)((int64_t)rows * (index + 1) / count);
+		copy_rows(job, box, y1, y2);
+	}
+	if (job->clean_cache) {
+		dcache_barrier();
+	}
+}
+
+struct fbdev_copy_worker {
+	struct fbdev_copy_pool *pool;
+	int index;
+};
+
+static void *copy_worker(void *data) {
+	struct fbdev_copy_worker *worker = data;
+	struct fbdev_copy_pool *pool = worker->pool;
+	int index = worker->index;
+	free(worker);
+
+	uint64_t seen = 0;
+	pthread_mutex_lock(&pool->lock);
+	for (;;) {
+		while (!pool->quit && pool->generation == seen) {
+			pthread_cond_wait(&pool->start, &pool->lock);
+		}
+		if (pool->quit) {
+			break;
+		}
+		seen = pool->generation;
+		struct fbdev_copy_job job = pool->job;
+		pthread_mutex_unlock(&pool->lock);
+
+		copy_job_part(&job, index, pool->nthreads);
+
+		pthread_mutex_lock(&pool->lock);
+		if (--pool->pending == 0) {
+			pthread_cond_signal(&pool->done);
+		}
+	}
+	pthread_mutex_unlock(&pool->lock);
+	return NULL;
+}
+
+static void copy_pool_destroy(struct fbdev_copy_pool *pool) {
+	if (pool == NULL) {
+		return;
+	}
+	pthread_mutex_lock(&pool->lock);
+	pool->quit = true;
+	pthread_cond_broadcast(&pool->start);
+	pthread_mutex_unlock(&pool->lock);
+	for (int i = 1; i < pool->nthreads; i++) {
+		pthread_join(pool->threads[i], NULL);
+	}
+	pthread_cond_destroy(&pool->start);
+	pthread_cond_destroy(&pool->done);
+	pthread_mutex_destroy(&pool->lock);
+	free(pool->threads);
+	free(pool);
+}
+
+static struct fbdev_copy_pool *copy_pool_create(int nthreads) {
+	if (nthreads <= 1) {
+		return NULL;
+	}
+	struct fbdev_copy_pool *pool = calloc(1, sizeof(*pool));
+	if (pool == NULL) {
+		return NULL;
+	}
+	pthread_mutex_init(&pool->lock, NULL);
+	pthread_cond_init(&pool->start, NULL);
+	pthread_cond_init(&pool->done, NULL);
+	pool->threads = calloc(nthreads, sizeof(*pool->threads));
+	pool->nthreads = 1;
+	if (pool->threads == NULL) {
+		copy_pool_destroy(pool);
+		return NULL;
+	}
+	for (int i = 1; i < nthreads; i++) {
+		struct fbdev_copy_worker *worker = malloc(sizeof(*worker));
+		if (worker == NULL) {
+			break;
+		}
+		worker->pool = pool;
+		worker->index = i;
+		if (pthread_create(&pool->threads[i], NULL, copy_worker, worker) != 0) {
+			free(worker);
+			break;
+		}
+		pool->nthreads++;
+	}
+	if (pool->nthreads == 1) {
+		copy_pool_destroy(pool);
+		return NULL;
+	}
+	return pool;
+}
+
+static void copy_job_run(struct fbdev_copy_pool *pool, const struct fbdev_copy_job *job) {
+	if (pool == NULL) {
+		copy_job_part(job, 0, 1);
+		return;
+	}
+	pthread_mutex_lock(&pool->lock);
+	pool->job = *job;
+	pool->pending = pool->nthreads - 1;
+	pool->generation++;
+	pthread_cond_broadcast(&pool->start);
+	pthread_mutex_unlock(&pool->lock);
+
+	copy_job_part(job, 0, pool->nthreads);
+
+	pthread_mutex_lock(&pool->lock);
+	while (pool->pending > 0) {
+		pthread_cond_wait(&pool->done, &pool->lock);
+	}
+	pthread_mutex_unlock(&pool->lock);
+}
