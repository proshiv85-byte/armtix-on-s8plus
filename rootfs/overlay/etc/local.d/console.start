#!/bin/sh
# Console diagnostics + login launcher.
LOG=/root/console-getty.log
{
  echo "=== console diag $(date -u) ==="
  [ -e /dev/tty0 ] || mknod /dev/tty0 c 4 0 2>/dev/null
  [ -e /dev/tty1 ] || mknod /dev/tty1 c 4 1 2>/dev/null
  [ -e /dev/ttySAC2 ] || mknod /dev/ttySAC2 c 204 2 2>/dev/null
  ls -la /dev/console /dev/tty0 /dev/tty1 /dev/ttySAC2 2>&1
  echo "active consoles: $(cat /sys/class/tty/console/active 2>&1)"
} > "$LOG" 2>&1

# Marker probe: which device actually reaches the visible display?
for dev in /dev/tty0 /dev/tty1 /dev/console; do
  echo "MARKER-${dev##*/}" > "$dev" 2>> "$LOG"
done

# The screen login (autologin armtix -> XFCE) is the agetty.tty1 service
# (/etc/conf.d/agetty.tty1); OpenRC >= 0.63 kills gettys started from here.
exit 0
