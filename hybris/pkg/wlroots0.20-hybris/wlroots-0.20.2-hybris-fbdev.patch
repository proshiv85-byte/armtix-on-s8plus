diff --git a/render/gles2/hybris.c b/render/gles2/hybris.c
new file mode 100644
index 0000000..251635b
--- /dev/null
+++ b/render/gles2/hybris.c
@@ -0,0 +1,318 @@
+#include <assert.h>
+#include <GLES2/gl2.h>
+#include <drm_fourcc.h>
+#include <stdlib.h>
+#include <wayland-server-protocol.h>
+#include <wlr/interfaces/wlr_buffer.h>
+#include <wlr/render/allocator.h>
+#include <wlr/render/drm_format_set.h>
+#include <wlr/util/log.h>
+#include "render/egl.h"
+#include "render/drm_format_set.h"
+#include "render/hybris.h"
+
+// Android HAL pixel formats and gralloc usage bits (system/graphics.h,
+// hardware/gralloc.h)
+#define HAL_PIXEL_FORMAT_RGBA_8888 1
+#define HAL_PIXEL_FORMAT_RGBX_8888 2
+#define HAL_PIXEL_FORMAT_BGRA_8888 5
+#define GRALLOC_USAGE_SW_READ_OFTEN 0x00000003
+#define GRALLOC_USAGE_SW_WRITE_OFTEN 0x00000030
+#define GRALLOC_USAGE_HW_TEXTURE 0x00000100
+#define GRALLOC_USAGE_HW_RENDER 0x00000200
+
+struct wlr_hybris_buffer {
+	struct wlr_buffer base;
+	struct wlr_egl *egl;
+	EGLClientBuffer native;
+	uint32_t drm_format;
+	size_t stride; // bytes
+};
+
+struct wlr_hybris_allocator {
+	struct wlr_allocator base;
+	struct wlr_egl *egl;
+};
+
+static const struct wlr_buffer_impl hybris_buffer_impl;
+
+// With GLVND, eglHybris* calls go to the vendor of the current context
+#define WITH_HYBRIS_CONTEXT(egl, ...) do { \
+		struct wlr_egl_context prev_ctx; \
+		wlr_egl_make_current(egl, &prev_ctx); \
+		__VA_ARGS__; \
+		wlr_egl_restore_context(&prev_ctx); \
+	} while (0)
+
+static struct wlr_hybris_buffer *hybris_buffer_from_buffer(
+		struct wlr_buffer *wlr_buffer) {
+	assert(wlr_buffer->impl == &hybris_buffer_impl);
+	struct wlr_hybris_buffer *buffer = wl_container_of(wlr_buffer, buffer, base);
+	return buffer;
+}
+
+bool wlr_buffer_is_hybris(struct wlr_buffer *buffer) {
+	return buffer->impl == &hybris_buffer_impl;
+}
+
+EGLClientBuffer hybris_buffer_get_native(struct wlr_buffer *buffer) {
+	return hybris_buffer_from_buffer(buffer)->native;
+}
+
+static void hybris_buffer_destroy(struct wlr_buffer *wlr_buffer) {
+	struct wlr_hybris_buffer *buffer = hybris_buffer_from_buffer(wlr_buffer);
+	wlr_buffer_finish(wlr_buffer);
+	WITH_HYBRIS_CONTEXT(buffer->egl,
+		buffer->egl->hybris.release_native_buffer(buffer->native));
+	free(buffer);
+}
+
+static bool hybris_buffer_begin_data_ptr_access(struct wlr_buffer *wlr_buffer,
+		uint32_t flags, void **data, uint32_t *format, size_t *stride) {
+	struct wlr_hybris_buffer *buffer = hybris_buffer_from_buffer(wlr_buffer);
+
+	EGLint usage = 0;
+	if (flags & WLR_BUFFER_DATA_PTR_ACCESS_READ) {
+		usage |= GRALLOC_USAGE_SW_READ_OFTEN;
+	}
+	if (flags & WLR_BUFFER_DATA_PTR_ACCESS_WRITE) {
+		usage |= GRALLOC_USAGE_SW_WRITE_OFTEN;
+	}
+	// gralloc lock makes CPU caches coherent but doesn't wait for the GPU
+	// (Android passes fences around instead): wait for our rendering first,
+	// or the CPU reads half-rendered tiles
+	EGLBoolean ok;
+	WITH_HYBRIS_CONTEXT(buffer->egl,
+		glFinish();
+		ok = buffer->egl->hybris.lock_native_buffer(buffer->native, usage, 0, 0,
+			wlr_buffer->width, wlr_buffer->height, data));
+	if (!ok) {
+		wlr_log(WLR_ERROR, "Failed to lock gralloc buffer");
+		return false;
+	}
+	*format = buffer->drm_format;
+	*stride = buffer->stride;
+	return true;
+}
+
+static void hybris_buffer_end_data_ptr_access(struct wlr_buffer *wlr_buffer) {
+	struct wlr_hybris_buffer *buffer = hybris_buffer_from_buffer(wlr_buffer);
+	WITH_HYBRIS_CONTEXT(buffer->egl,
+		buffer->egl->hybris.unlock_native_buffer(buffer->native));
+}
+
+static const struct wlr_buffer_impl hybris_buffer_impl = {
+	.destroy = hybris_buffer_destroy,
+	.begin_data_ptr_access = hybris_buffer_begin_data_ptr_access,
+	.end_data_ptr_access = hybris_buffer_end_data_ptr_access,
+};
+
+static int hal_format_from_drm(uint32_t drm_format) {
+	// DRM formats are little-endian, HAL formats are named in byte order
+	switch (drm_format) {
+	case DRM_FORMAT_ARGB8888:
+	case DRM_FORMAT_XRGB8888:
+		return HAL_PIXEL_FORMAT_BGRA_8888;
+	case DRM_FORMAT_ABGR8888:
+		return HAL_PIXEL_FORMAT_RGBA_8888;
+	case DRM_FORMAT_XBGR8888:
+		return HAL_PIXEL_FORMAT_RGBX_8888;
+	default:
+		return -1;
+	}
+}
+
+static struct wlr_buffer *hybris_allocator_create_buffer(
+		struct wlr_allocator *wlr_alloc, int width, int height,
+		const struct wlr_drm_format *format) {
+	struct wlr_hybris_allocator *alloc = wl_container_of(wlr_alloc, alloc, base);
+
+	int hal_format = hal_format_from_drm(format->format);
+	if (hal_format < 0) {
+		wlr_log(WLR_ERROR, "Unsupported pixel format 0x%"PRIX32, format->format);
+		return NULL;
+	}
+	if (!wlr_drm_format_has(format, DRM_FORMAT_MOD_LINEAR) &&
+			!wlr_drm_format_has(format, DRM_FORMAT_MOD_INVALID)) {
+		wlr_log(WLR_ERROR, "gralloc buffers only support linear layout");
+		return NULL;
+	}
+
+	struct wlr_hybris_buffer *buffer = calloc(1, sizeof(*buffer));
+	if (buffer == NULL) {
+		return NULL;
+	}
+
+	EGLint usage = GRALLOC_USAGE_HW_RENDER | GRALLOC_USAGE_HW_TEXTURE |
+		GRALLOC_USAGE_SW_READ_OFTEN | GRALLOC_USAGE_SW_WRITE_OFTEN;
+	EGLint stride_px = 0;
+	EGLBoolean ok;
+	WITH_HYBRIS_CONTEXT(alloc->egl,
+		ok = alloc->egl->hybris.create_native_buffer(width, height, usage,
+			hal_format, &stride_px, &buffer->native));
+	if (!ok) {
+		wlr_log(WLR_ERROR, "Failed to allocate %dx%d gralloc buffer", width, height);
+		free(buffer);
+		return NULL;
+	}
+
+	wlr_buffer_init(&buffer->base, &hybris_buffer_impl, width, height);
+	buffer->egl = alloc->egl;
+	buffer->drm_format = format->format;
+	buffer->stride = (size_t)stride_px * 4;
+	return &buffer->base;
+}
+
+static void hybris_allocator_destroy(struct wlr_allocator *wlr_alloc) {
+	struct wlr_hybris_allocator *alloc = wl_container_of(wlr_alloc, alloc, base);
+	free(alloc);
+}
+
+static const struct wlr_allocator_interface hybris_allocator_impl = {
+	.create_buffer = hybris_allocator_create_buffer,
+	.destroy = hybris_allocator_destroy,
+};
+
+struct wlr_allocator *hybris_allocator_create(struct wlr_egl *egl) {
+	assert(egl->is_hybris);
+	struct wlr_hybris_allocator *alloc = calloc(1, sizeof(*alloc));
+	if (alloc == NULL) {
+		return NULL;
+	}
+	wlr_allocator_init(&alloc->base, &hybris_allocator_impl, WLR_BUFFER_CAP_DATA_PTR);
+	alloc->egl = egl;
+	wlr_log(WLR_DEBUG, "Created hybris gralloc allocator");
+	return &alloc->base;
+}
+
+/*
+ * wayland-android client buffers. libhybris owns the wl_buffer resource, so
+ * the wlr_buffer is found again through a destroy listener on it.
+ */
+
+struct wlr_hybris_wlegl_buffer {
+	struct wlr_buffer base;
+	struct wl_resource *resource; // NULL once the client destroyed it
+	bool has_alpha;
+	struct wl_listener resource_destroy;
+	struct wl_listener release;
+};
+
+// The wayland-android protocol is per process, as is libhybris' EGL state
+static struct wlr_egl *wlegl_egl = NULL;
+
+static const struct wlr_buffer_impl wlegl_buffer_impl;
+
+static struct wlr_hybris_wlegl_buffer *wlegl_buffer_from_buffer(
+		struct wlr_buffer *wlr_buffer) {
+	assert(wlr_buffer->impl == &wlegl_buffer_impl);
+	struct wlr_hybris_wlegl_buffer *buffer = wl_container_of(wlr_buffer, buffer, base);
+	return buffer;
+}
+
+bool wlr_buffer_is_hybris_wlegl(struct wlr_buffer *buffer) {
+	return buffer->impl == &wlegl_buffer_impl;
+}
+
+struct wl_resource *hybris_wlegl_buffer_get_resource(struct wlr_buffer *buffer) {
+	return wlegl_buffer_from_buffer(buffer)->resource;
+}
+
+bool hybris_wlegl_buffer_has_alpha(struct wlr_buffer *buffer) {
+	return wlegl_buffer_from_buffer(buffer)->has_alpha;
+}
+
+static void wlegl_buffer_destroy(struct wlr_buffer *wlr_buffer) {
+	struct wlr_hybris_wlegl_buffer *buffer = wlegl_buffer_from_buffer(wlr_buffer);
+	wl_list_remove(&buffer->release.link);
+	if (buffer->resource != NULL) {
+		wl_list_remove(&buffer->resource_destroy.link);
+	}
+	wlr_buffer_finish(wlr_buffer);
+	free(buffer);
+}
+
+static const struct wlr_buffer_impl wlegl_buffer_impl = {
+	.destroy = wlegl_buffer_destroy,
+};
+
+static void wlegl_buffer_handle_resource_destroy(struct wl_listener *listener,
+		void *data) {
+	struct wlr_hybris_wlegl_buffer *buffer =
+		wl_container_of(listener, buffer, resource_destroy);
+	wl_list_remove(&buffer->resource_destroy.link);
+	buffer->resource = NULL;
+	wlr_buffer_drop(&buffer->base);
+}
+
+static void wlegl_buffer_handle_release(struct wl_listener *listener, void *data) {
+	struct wlr_hybris_wlegl_buffer *buffer = wl_container_of(listener, buffer, release);
+	if (buffer->resource != NULL) {
+		wl_buffer_send_release(buffer->resource);
+	}
+}
+
+static bool wlegl_resource_is_instance(struct wl_resource *resource) {
+	EGLint width;
+	return wlegl_egl != NULL && wlegl_egl->hybris.query_wayland_buffer(
+		wlegl_egl->display, resource, EGL_WIDTH, &width);
+}
+
+static struct wlr_buffer *wlegl_buffer_from_resource(struct wl_resource *resource) {
+	struct wl_listener *listener = wl_resource_get_destroy_listener(resource,
+		wlegl_buffer_handle_resource_destroy);
+	if (listener != NULL) {
+		struct wlr_hybris_wlegl_buffer *buffer =
+			wl_container_of(listener, buffer, resource_destroy);
+		return &buffer->base;
+	}
+
+	EGLint width, height, texture_format;
+	if (!wlegl_egl->hybris.query_wayland_buffer(wlegl_egl->display, resource,
+				EGL_WIDTH, &width) ||
+			!wlegl_egl->hybris.query_wayland_buffer(wlegl_egl->display, resource,
+				EGL_HEIGHT, &height)) {
+		return NULL;
+	}
+	if (!wlegl_egl->hybris.query_wayland_buffer(wlegl_egl->display, resource,
+			EGL_TEXTURE_FORMAT, &texture_format)) {
+		texture_format = EGL_TEXTURE_RGBA;
+	}
+
+	struct wlr_hybris_wlegl_buffer *buffer = calloc(1, sizeof(*buffer));
+	if (buffer == NULL) {
+		return NULL;
+	}
+	wlr_buffer_init(&buffer->base, &wlegl_buffer_impl, width, height);
+	buffer->resource = resource;
+	buffer->has_alpha = texture_format != EGL_TEXTURE_RGB;
+
+	buffer->resource_destroy.notify = wlegl_buffer_handle_resource_destroy;
+	wl_resource_add_destroy_listener(resource, &buffer->resource_destroy);
+
+	buffer->release.notify = wlegl_buffer_handle_release;
+	wl_signal_add(&buffer->base.events.release, &buffer->release);
+
+	return &buffer->base;
+}
+
+static const struct wlr_buffer_resource_interface wlegl_resource_interface = {
+	.name = "android_wlegl",
+	.is_instance = wlegl_resource_is_instance,
+	.from_resource = wlegl_buffer_from_resource,
+};
+
+bool hybris_init_wl_display(struct wlr_egl *egl, struct wl_display *display) {
+	assert(egl->is_hybris);
+	if (wlegl_egl != NULL) {
+		return true;
+	}
+	if (!egl->hybris.bind_wayland_display(egl->display, display)) {
+		wlr_log(WLR_ERROR, "eglBindWaylandDisplayWL failed");
+		return false;
+	}
+	wlegl_egl = egl;
+	wlr_buffer_register_resource_interface(&wlegl_resource_interface);
+	wlr_log(WLR_INFO, "libhybris wayland-android buffer sharing enabled");
+	return true;
+}
