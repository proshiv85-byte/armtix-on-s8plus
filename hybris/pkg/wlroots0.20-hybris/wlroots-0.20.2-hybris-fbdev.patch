+/*
+ * libhybris support: Android EGL drivers (e.g. the Mali blob) loaded into a
+ * glibc process. There is no DRM device, GBM or DMA-BUF import; render
+ * targets are gralloc buffers wrapped as EGLImages (EGL_NATIVE_BUFFER_ANDROID)
+ * and GPU clients share gralloc buffers through libhybris' wayland-android
+ * protocol (EGL_WL_bind_wayland_display).
+ */
+
+#ifndef EGL_PLATFORM_ANDROID_KHR
+#define EGL_PLATFORM_ANDROID_KHR 0x3141
+#endif
+#ifndef EGL_NATIVE_BUFFER_ANDROID
+#define EGL_NATIVE_BUFFER_ANDROID 0x3140
+#endif
+#ifndef EGL_WAYLAND_BUFFER_WL
+#define EGL_WAYLAND_BUFFER_WL 0x31D5
+#endif
+
+struct wlr_egl;
+struct wlr_renderer;
+
+struct wlr_hybris_procs {
+	EGLBoolean (*create_native_buffer)(EGLint width, EGLint height, EGLint usage,
+		EGLint format, EGLint *stride, EGLClientBuffer *buffer);
+	EGLBoolean (*lock_native_buffer)(EGLClientBuffer buffer, EGLint usage,
+		EGLint l, EGLint t, EGLint w, EGLint h, void **vaddr);
+	EGLBoolean (*unlock_native_buffer)(EGLClientBuffer buffer);
+	EGLBoolean (*release_native_buffer)(EGLClientBuffer buffer);
+	EGLBoolean (*bind_wayland_display)(EGLDisplay dpy, struct wl_display *display);
+	EGLBoolean (*unbind_wayland_display)(EGLDisplay dpy, struct wl_display *display);
+	EGLBoolean (*query_wayland_buffer)(EGLDisplay dpy, struct wl_resource *buffer,
+		EGLint attribute, EGLint *value);
+};
+
+/**
+ * Creates an EGL display/context on libhybris' Android platform. Returns NULL
+ * if libhybris is not the EGL implementation.
+ */
+struct wlr_egl *wlr_egl_create_hybris(void);
+
+/** GLES2 renderer on libhybris EGL, NULL if libhybris is not available. */
+struct wlr_renderer *wlr_gles2_renderer_create_hybris(void);
+
+/** gralloc-backed buffers that the GLES2 renderer can render into. */
+struct wlr_allocator *hybris_allocator_create(struct wlr_egl *egl);
+bool wlr_buffer_is_hybris(struct wlr_buffer *buffer);
+EGLClientBuffer hybris_buffer_get_native(struct wlr_buffer *buffer);
+
+/** Client buffers created through libhybris' wayland-android protocol. */
+bool wlr_buffer_is_hybris_wlegl(struct wlr_buffer *buffer);
+struct wl_resource *hybris_wlegl_buffer_get_resource(struct wlr_buffer *buffer);
+bool hybris_wlegl_buffer_has_alpha(struct wlr_buffer *buffer);
+
+/**
+ * Advertises libhybris' wayland-android global on the display and lets
+ * wlr_buffer_try_from_resource() handle its buffers.
+ */
+bool hybris_init_wl_display(struct wlr_egl *egl, struct wl_display *display);
+
+#endif
