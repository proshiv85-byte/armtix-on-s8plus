+/*
+ * ARMtix: keep the USB PHY supplies on. On Android the usb_notifier turns
+ * them on at cable attach (otg_notify set_ldo_onoff); on a plain Linux
+ * rootfs that event is never delivered, the regulator core switches them
+ * off as "unused" at late init, and every DWC3 endpoint command times out.
+ */
+&ldo6_reg {	/* hs-regulator, USB2 PHY 3.3V */
+	regulator-always-on;
+};
+
+&ldo10_reg {	/* ss-regulator, USB3 PHY 0.85V */
